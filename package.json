{
  "name": "slick-workspace",
  "version": "0.5.0",
  "private": true,
  "description": "Slick — a Slack-like workspace for one human and their AI agents",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "slick": "node packages/cli/bin/slick.js",
    "app": "node packages/cli/bin/slick.js app",
    "serve": "node packages/server/bin/slickd.js --foreground",
    "desktop": "npm start --workspace @slick/desktop",
    "test": "vitest run && npm run test:legacy",
    "test:legacy": "node --test --no-warnings \"apps/web/test/*.test.js\"",
    "test:watch": "vitest",
    "test:core": "vitest run --project core",
    "test:server": "vitest run --project server",
    "test:cli": "vitest run --project cli",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "smoke:ui": "electron scripts/ui-smoke.mjs",
    "shots": "electron scripts/ui-shots.mjs",
    "seed": "node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/web-push": "^3.6.4",
    "electron": "^43.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
