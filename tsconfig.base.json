{
  // Shared by every package. Node packages run their .ts sources directly
  // through Node's type stripping, so the options below are not a style
  // preference — `erasableSyntaxOnly` and `verbatimModuleSyntax` are what
  // keeps a file that type-checks from failing at load time.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
